{
  "name": "portal-intranet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portal Intranet Di Paula",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "servidor",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w servidor\" \"npm run dev -w web\"",
    "banco:migrar": "npm run migrar -w servidor",
    "banco:seed": "npm run seed -w servidor",
    "test": "node --test web/test/*.test.ts",
    "build": "npm run build -w web",
    "typecheck": "tsc --noEmit -p web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
