{
  "name": "portal-intranet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portal Intranet Di Paula",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "servidor",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w servidor\" \"npm run dev -w web\"",
    "dev:rede": "concurrently -k -n api,web -c blue,green \"npm run dev -w servidor\" \"npm run dev -w web -- --host\"",
    "banco:migrar": "npm run migrar -w servidor",
    "banco:seed": "npm run seed -w servidor",
    "admin:criar": "npm run admin -w servidor --",
    "test": "node --test web/test/*.test.ts modulos/*/tests/*.test.ts servidor/tests/*.test.ts",
    "build": "npm run build -w web",
    "typecheck": "tsc --noEmit -p web && tsc --noEmit -p servidor",
    "demo": "npm run banco:migrar && npm run demo -w servidor",
    "start": "npm run start -w servidor",
    "backup": "npm run backup -w servidor",
    "publicar": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2"
  }
}
