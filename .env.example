# Configuração do servidor do portal (copie para servidor/.env e ajuste). O arquivo .env NUNCA vai para o Git.
# Um .env por ambiente (teste e produção), cada um com seu banco.

NODE_ENV=production

# Endereço PÚBLICO do portal, com https (obrigatório em produção; vários separados por vírgula).
ORIGENS_PERMITIDAS=https://portal.suaempresa.com.br

# Porta interna e endereço de escuta. Atrás de um proxy reverso, deixe HOST=127.0.0.1.
PORTA=3100
HOST=127.0.0.1
# 1 quando o portal fica atrás de proxy reverso (IIS, nginx, Caddy...).
TRUST_PROXY=1

# Banco SQLite deste ambiente e pasta dos documentos servidos pelo portal (caminhos absolutos).
BANCO=D:\portal\dados\portal.db
DOCUMENTOS_PASTA=D:\portal\documentos

# Backups: pasta de destino e quantos dias manter.
PASTA_BACKUP=D:\portal\backups
BACKUP_MANTER_DIAS=30

# Só no ambiente de TESTE, se quiser ligar os dados fictícios de exemplo (nunca em produção).
# PERMITIR_DADOS_EXEMPLO=1
